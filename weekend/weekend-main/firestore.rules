rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny read/write access to any document by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user profiles collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
      
      // Permit creation only for the authenticated owner, preventing role escalation
      allow create: if request.auth != null && request.auth.uid == userId 
                    && request.resource.data.role == 'user'
                    && request.resource.data.keys().hasAll(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.createdAt is string;
                    
      // Prevent user modification of critical protected fields
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin')
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'role', 'ownerId', 'createdAt', 'balance', 'admin', 'verificationStatus'
                    ]);
                    
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
